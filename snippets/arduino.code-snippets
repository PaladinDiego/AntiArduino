  "Serial begin con espera": {
    "prefix": "aserialbegin",
    "scope": "cpp",
    "body": [
      "Serial.begin(${1:115200});",
      "while (!Serial) { delay(10); }  // necesario en 32U4/SAMD/ESP32-S3 USB-CDC",
      "Serial.println(F(\"${2:Sistema listo}\"));"
    ],
    "description": "Serial.begin robusto en placas con USB nativo"
  },

  "Buffer serial caracter por caracter (OBLIGATORIO con log2file)": {
    "prefix": "aserialbuffer",
    "scope": "cpp",
    "body": [
      "// Lectura caracter por caracter.",
      "// NO uses Serial.readStringUntil(): con send_on_enter deshabilitado",
      "// (lo que pasa al lanzar el monitor con --filter log2file) cada tecla",
      "// llega suelta y readStringUntil corta las palabras por timeout.",
      "String cmd = \"\";",
      "",
      "void handleSerial() {",
      "  while (Serial.available() > 0) {",
      "    char c = Serial.read();",
      "    if (c == '\\\\n' || c == '\\\\r') {",
      "      if (cmd.length() > 0) {",
      "        cmd.trim();",
      "        ${1:// --- procesar comando ---}",
      "        if (cmd.equalsIgnoreCase(\"ON\")) {",
      "          digitalWrite(LED_BUILTIN, HIGH);",
      "          Serial.println(F(\"LED ON\"));",
      "        } else if (cmd.equalsIgnoreCase(\"OFF\")) {",
      "          digitalWrite(LED_BUILTIN, LOW);",
      "          Serial.println(F(\"LED OFF\"));",
      "        } else {",
      "          Serial.print(F(\"Comando desconocido: \"));",
      "          Serial.println(cmd);",
      "        }",
      "        cmd = \"\";",
      "      }",
      "    } else {",
      "      cmd += c;",
      "    }",
      "  }",
      "}$0"
    ],
    "description": "Patron de buffer serial resistente. El unico que funciona en este entorno."
  },

  "Timer no bloqueante con millis()": {
    "prefix": "amillis",
    "scope": "cpp",
    "body": [
      "static unsigned long ${1:lastRun} = 0;",
      "const unsigned long ${2:INTERVAL_MS} = ${3:1000};",
      "",
      "if (millis() - ${1:lastRun} >= ${2:INTERVAL_MS}) {",
      "  ${1:lastRun} = millis();",
      "  $0",
      "}"
    ],
    "description": "Temporizador sin delay(), inmune al overflow de millis()"
  },

  "Interrupcion externa": {
    "prefix": "ainterrupt",
    "scope": "cpp",
    "body": [
      "volatile bool ${1:flagISR} = false;",
      "",
      "void IRAM_ATTR ${2:onPulse}() {   // IRAM_ATTR solo en ESP32; en AVR quitalo",
      "  ${1:flagISR} = true;",
      "}",
      "",
      "// en setup():",
      "pinMode(${3:2}, INPUT_PULLUP);",
      "attachInterrupt(digitalPinToInterrupt(${3:2}), ${2:onPulse}, ${4|FALLING,RISING,CHANGE|});",
      "$0"
    ],
    "description": "ISR con flag volatil (nunca hagas Serial.print dentro de una ISR)"
  },

  "Antirrebote de boton (no bloqueante)": {
    "prefix": "adebounce",
    "scope": "cpp",
    "body": [
      "const uint8_t ${1:BTN_PIN} = ${2:4};",
      "const unsigned long DEBOUNCE_MS = 50;",
      "static bool lastReading = HIGH;",
      "static bool stableState = HIGH;",
      "static unsigned long lastChange = 0;",
      "",
      "bool reading = digitalRead(${1:BTN_PIN});",
      "if (reading != lastReading) { lastChange = millis(); }",
      "if (millis() - lastChange > DEBOUNCE_MS && reading != stableState) {",
      "  stableState = reading;",
      "  if (stableState == LOW) { $0 }",
      "}",
      "lastReading = reading;"
    ],
    "description": "Debounce sin delay()"
  },

  "Tarea FreeRTOS (ESP32)": {
