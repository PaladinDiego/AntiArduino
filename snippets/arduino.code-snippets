  "Lectura analogica promediada": {
    "prefix": "aanalog",
    "scope": "cpp",
    "body": [
      "int readAveraged(uint8_t pin, uint8_t samples = ${1:16}) {",
      "  long total = 0;",
      "  for (uint8_t i = 0; i < samples; i++) {",
      "    total += analogRead(pin);",
      "    delayMicroseconds(200);",
      "  }",
      "  return (int)(total / samples);",
      "}$0"
    ],
    "description": "Promedia lecturas del ADC para reducir ruido"
  }
