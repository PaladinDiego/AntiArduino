  "Conexion WiFi (ESP32) con timeout": {
    "prefix": "awifi",
    "scope": "cpp",
    "body": [
      "#include <WiFi.h>",
      "",
      "const char *WIFI_SSID = \"${1:MiRed}\";",
      "const char *WIFI_PASS = \"${2:MiClave}\";",
      "",
      "bool connectWiFi(unsigned long timeoutMs = 15000) {",
      "  WiFi.mode(WIFI_STA);",
      "  WiFi.begin(WIFI_SSID, WIFI_PASS);",
      "  unsigned long start = millis();",
      "  while (WiFi.status() != WL_CONNECTED) {",
      "    if (millis() - start > timeoutMs) {",
      "      Serial.println(F(\"[FAIL] WiFi timeout\"));",
      "      return false;",
      "    }",
      "    delay(250);",
      "  }",
      "  Serial.print(F(\"[OK] IP: \"));",
      "  Serial.println(WiFi.localIP());",
      "  return true;",
      "}$0"
    ],
    "description": "WiFi con timeout real, no un while infinito"
  },

  "Servidor web minimo (ESP32) con boton": {
    "prefix": "awebserver",
    "scope": "cpp",
    "body": [
      "#include <WiFi.h>",
      "#include <WebServer.h>",
      "",
      "WebServer server(80);",
      "",
      "void handleRoot() {",
      "  server.send(200, \"text/html\",",
      "    \"<!DOCTYPE html><html><body style='font-family:sans-serif;text-align:center'>\"",
      "    \"<h2>${1:Control}</h2>\"",
      "    \"<p><a href='/on'><button style='font-size:2em'>ON</button></a></p>\"",
      "    \"<p><a href='/off'><button style='font-size:2em'>OFF</button></a></p>\"",
      "    \"</body></html>\");",
      "}",
      "",
      "void setupServer() {",
      "  server.on(\"/\", handleRoot);",
      "  server.on(\"/on\", []() { ${2:Serial2.println(\"ON\");} server.sendHeader(\"Location\", \"/\"); server.send(303); });",
      "  server.on(\"/off\", []() { ${3:Serial2.println(\"OFF\");} server.sendHeader(\"Location\", \"/\"); server.send(303); });",
      "  server.begin();",
      "}$0"
    ],
    "description": "Pagina LAN con botones que disparan acciones"
  },

  "Enlace serie ESP32 -> Arduino (SoftwareSerial)": {
    "prefix": "aserialbridge",
    "scope": "cpp",
    "body": [
      "// LADO ARDUINO (receptor). Cableado unidireccional:",
      "//   ESP32 GPIO17 (TX2, 3.3V) -> Arduino pin ${1:2} (RX)",
      "//   GND comun OBLIGATORIO. NO conectes el TX del Arduino (5V) al ESP32.",
      "//   Pines 0/1 estan reservados por USB: usa SoftwareSerial.",
      "#include <Arduino.h>",
      "#include <SoftwareSerial.h>",
      "",
      "SoftwareSerial link(${1:2}, ${2:3});  // RX, TX",
      "String buf = \"\";",
      "",
      "void setup() {",
      "  Serial.begin(115200);",
      "  link.begin(9600);            // SoftwareSerial es fiable hasta ~9600-19200",
      "  pinMode(LED_BUILTIN, OUTPUT);",
      "}",
      "",
      "void loop() {",
      "  while (link.available() > 0) {",
      "    char c = link.read();",
      "    if (c == '\\\\n' || c == '\\\\r') {",
      "      if (buf.length() > 0) {",
      "        buf.trim();",
      "        digitalWrite(LED_BUILTIN, buf.equalsIgnoreCase(\"ON\") ? HIGH : LOW);",
      "        Serial.print(F(\"Recibido: \")); Serial.println(buf);",
      "        buf = \"\";",
      "      }",
      "    } else {",
      "      buf += c;",
      "    }",
      "  }",
      "  $0",
      "}"
    ],
    "description": "Puente serie ESP32->Arduino con nivel logico seguro"
  },

